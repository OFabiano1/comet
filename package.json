{
  "name": "comet",
  "version": "0.1.0",
  "description": "Baixa vídeos do YouTube (.mp4/.mp3) e GIFs por link — de player pra player.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Comet --platform win32 --arch x64 --out dist --overwrite --ignore \"^/(dist|test|docs|\\.superpowers|scripts)($|/|\\\\)\" --ignore \"^/(\\.gitignore|package-lock\\.json)$\""
  },
  "author": "Axolotl BR",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
